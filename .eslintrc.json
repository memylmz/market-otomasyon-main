{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2023,
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint",
    "react-hooks"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "browser": true,
    "es2023": true
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "out",
    ".next",
    "*.config.*",
    "packages/shared/dist"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "error",
    "no-console": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-irregular-whitespace": [
      "error",
      {
        "skipStrings": true,
        "skipRegExps": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/test/**/*.ts",
        "**/*.test.ts",
        "**/scripts/**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/no-non-null-assertion": "off"
      }
    }
  ]
}
