# Market Otomasyon — Bulut API ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp doldurun. `.env` asla depoya girmez.

NODE_ENV=development
# 3000 bilinçli olarak kullanılmaz: Node projelerinin varsayılan portudur ve
# aynı makinede başka bir uygulama orada dinliyorsa (özellikle IPv6 `::1`
# üzerinde) istekler sessizce yanlış uygulamaya gider.
PORT=3010
HOST=0.0.0.0

# ── Veritabanı ───────────────────────────────────────────────────────────────
# Turso (önerilen, §6.4):
#   DB_URL=libsql://<veritabani>-<organizasyon>.turso.io
#   DB_AUTH_TOKEN=<turso db tokens create ile alınan token>
# Yerel dosya (geliştirme / kendi sunucum):
DB_URL=file:./veri/merkez.db
# DB_AUTH_TOKEN=

# ── Güvenlik ─────────────────────────────────────────────────────────────────
# ÜRETİMDE ZORUNLU. En az 32 karakter. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BOŞ BIRAKMAYIN: geliştirmede boşsa her yeniden başlatmada rastgele anahtar üretilir ve
# tüm panel oturumları düşer; üretimde sunucu hiç açılmaz.
JWT_SECRET=
ACCESS_TOKEN_OMRU=15m
REFRESH_TOKEN_OMRU=30d

# Panelin çalıştığı köken(ler); virgülle ayırın.
CORS_KOKENLER=http://localhost:3100

# ── Operasyon ────────────────────────────────────────────────────────────────
HIZ_LIMITI_DAKIKA=300
LOG_SEVIYESI=info

# Lisans doğrulanamadığında operasyonun kesilmeden süreceği gün sayısı (§23.3).
LISANS_GRACE_GUN=14
